# Copy this file to .env for local overrides. Do not commit .env.
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]
VITE_API_BASE_URL=http://localhost:8000

# Backend only. Never expose this value through VITE_* variables.
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
MARKET_DATA_TIMEOUT_SECONDS=10

# Backend-local SQLite database. Override with an absolute path when needed.
DATABASE_PATH=data/shapefinder.sqlite3

# Universe metadata is refreshed on demand after this many hours.
UNIVERSE_TTL_HOURS=24

# Named-universe searches hydrate only a small backend-controlled batch.
UNIVERSE_HYDRATION_MAX_SYMBOLS=5
UNIVERSE_HYDRATION_INTRADAY_MAX_SYMBOLS=2
UNIVERSE_HYDRATION_TIMEOUT_SECONDS=15

# Phase 11 request safety controls.
SCAN_TIMEOUT_SECONDS=60
MAX_CONCURRENT_SCANS=2
MAX_REQUEST_BODY_BYTES=65536
