{
	admin off
	persist_config off
	auto_https off
}

:{$PORT:3000} {
	@owner_host host {$SHAPEFINDER_PUBLIC_HOST}
	route {
		header Cache-Control "private, no-store"
		handle /__health {
			reverse_proxy {$BACKEND_UPSTREAM}
		}
		handle @owner_host {
			route {
				forward_auth {$BACKEND_UPSTREAM} {
					uri /__owner_auth
				}
				handle /api/* {
					reverse_proxy {$BACKEND_UPSTREAM}
				}
				root * /app/dist
				try_files {path} /index.html
				encode gzip
				file_server
			}
		}
		respond 421
	}
}
